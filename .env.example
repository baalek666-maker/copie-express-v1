# === Copie Express V1 — Environment Variables Template ===
# Copier ce fichier en .env.local (frontend) et .env (backend)
# ⚠️ JAMAIS commit ces fichiers remplis

# === Supabase ===
# Crée un projet sur https://supabase.com (région Frankfurt obligatoire)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# === Mistral AI ===
# Crée un compte sur https://console.mistral.ai et génère une clé API
MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# === Resend (emails transactionnels) ===
# Crée un compte sur https://resend.com et génère une clé
RESEND_API_KEY=re_xxxxxxxxxxxxxx
EMAIL_FROM=noreply@copie-express.fr

# === Stripe (PLUS TARD, quand tu veux encaisser) ===
# Crée un compte sur https://stripe.com (KYC identité requis)
# Active le mode test pour commencer
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxx
STRIPE_PRICE_MONTHLY=price_xxxxxxxxxxxxxx
STRIPE_PRICE_YEARLY=price_xxxxxxxxxxxxxx
STRIPE_PRICE_EXPERT=price_xxxxxxxxxxxxxx

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=4000
NODE_ENV=development